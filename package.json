{
    "name": "app",
    "version": "2021.12.14",
    "description": "",
    "private": true,
    "packageManager": "pnpm@11.17.0",
    "dependencies": {},
    "scripts": {
        "client/main": "shadow-cljs watch :main",
        "client/workspaces": "shadow-cljs watch :workspaces",
        "client/test": "shadow-cljs watch :test",
        "client/cljs": "shadow-cljs cljs-repl :main",
        "client/clj": "shadow-cljs clj-repl",
        "client/server": "shadow-cljs server",
        "client/nodejs": "shadow-cljs node-repl",
        "server": "clojure -A:dev -J-Dtrace -J-Dguardrails.enabled=true",
        "server/auto-start": "clojure -M:dev -e \"(require 'development)(in-ns 'development)(start)@(promise)\"",
        "start": "run-p client/server server",
        "dev": "run-p client/main server/auto-start"
    },
    "devDependencies": {
        "karma": "^6.4.4",
        "karma-chrome-launcher": "^3.2.0",
        "karma-cljs-test": "^0.1.0",
        "npm-run-all": "^4.1.5",
        "process": "^0.11.10",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "scheduler": "^0.27.0",
        "shadow-cljs": "^3.4.11"
    },
