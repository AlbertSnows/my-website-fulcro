{:paths ["src/main" "resources"]
 :mvn/local-repo ".m2/repository"
 :deps  {org.clojure/clojure                 {:mvn/version "1.12.5"}
         bidi/bidi                           {:mvn/version "2.1.6"}
         com.taoensso/timbre                 {:mvn/version "6.8.0"}
         com.wsscode/pathom                  {:mvn/version "2.4.0"}
         com.fulcrologic/fulcro              {:mvn/version "3.9.5"}
         com.fulcrologic/fulcro-garden-css   {:mvn/version "3.1.1"}
         com.fulcrologic/semantic-ui-wrapper {:mvn/version "2.1.5"}
         com.fulcrologic/guardrails          {:mvn/version "1.3.3"}
         garden/garden                       {:mvn/version "1.3.10"}
         hiccup/hiccup                       {:mvn/version "2.0.0"}
         http-kit/http-kit                   {:mvn/version "2.8.1"}
         mount/mount                         {:mvn/version "0.1.24"}
         org.clojure/core.async              {:mvn/version "1.9.865"}

         ;; To simulate Datomic on the back-end
         datascript/datascript               {:mvn/version "1.7.8"}

         ring/ring-core                      {:mvn/version "1.15.5"}
         ring/ring-defaults                  {:mvn/version "0.7.1"}}

 :aliases
 {:build {:deps {io.github.clojure/tools.build {:git/tag "v0.10.14" :git/sha "1176afd"}}
          :ns-default build}
  :clj-tests
  {:extra-paths ["src/test"]
   :main-opts   ["-m" "kaocha.runner"]
   :extra-deps  {lambdaisland/kaocha {:mvn/version "1.91.1392"}}}

         ;; See https://github.com/clojure-emacs/cider-nrepl/blob/master/deps.edn for Emacs support
  :dev     {:extra-paths ["src/test" "src/dev" "src/workspaces"]
            :jvm-opts    ["-XX:-OmitStackTraceInFastThrow"]
            :extra-deps  {org.clojure/clojurescript   {:mvn/version "1.12.145"}
                          thheller/shadow-cljs        {:mvn/version "3.4.11"}
                          fulcrologic/fulcro-spec     {:mvn/version "3.2.10"}
                          binaryage/devtools          {:mvn/version "1.0.7"}
                          com.github.awkay/workspaces {:mvn/version "1.1.4"}
                          org.clojure/tools.namespace {:mvn/version "1.5.1"}}}
  :nrepl {:main-opts ["-m" "nrepl.cmdline"
                      "-b" "0.0.0.0"
                      "-p" "9001"
                      "--middleware" "[cider.nrepl/cider-middleware]"]
          :extra-deps {nrepl/nrepl                 {:mvn/version,"1.7.0"}
                       cider/cider-nrepl           {:mvn/version,"0.62.2"}}}}}
